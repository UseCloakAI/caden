{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "import"
  ],
  "rules": {
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "@/ds/*",
              "@/ds/**"
            ],
            "message": "Import design-system components from '@/ds', not component internals."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/ds/**"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}