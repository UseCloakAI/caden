<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Caden" parent="android:Theme.Material.Light.NoActionBar">
        <!-- full screen, edge to edge: the sky runs under where the bars were -->
        <item name="android:windowBackground">@color/sky</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
    <color name="paper">#FFF7EE</color>
    <color name="sky">#0A2245</color>
    <color name="coral">#FF7A59</color>
</resources>
